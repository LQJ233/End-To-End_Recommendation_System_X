# 复制为 .env.local 后填入本机真实值（.env.local 已被 .gitignore 忽略，不会上传）
#
# 用法：
#   bash 脚本   -> 自动 source 项目根目录的 .env.local
#   Python 脚本 -> offline/pyspark/local_env.py 会自动读取该文件
#   Spring Boot -> backend/src/main/resources/application.yml 通过 spring.config.import 读取

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=recsys
MYSQL_PASSWORD=change-me
MYSQL_DATABASE=ecommerce

MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_ACCESS_KEY=change-me
MINIO_SECRET_KEY=change-me

JWT_SECRET=change-me-to-a-random-string-at-least-32-bytes

GRAFANA_ADMIN_PASSWORD=change-me
